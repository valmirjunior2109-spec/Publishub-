# Publishub backend — copie para `.env` e preencha.
# Este arquivo é só o MODELO: deixe todos os valores em branco, porque ele vai
# para o Git. As chaves de verdade ficam no `.env`, que nunca é versionado.

# Supabase → Project Settings → API
SUPABASE_URL=
# Chave secreta (service_role / "secret key"). Só existe no backend.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=videos
# Bucket dos prints da curva de retenção (criado pela migração 20260913)
SUPABASE_INSIGHTS_BUCKET=insights

# IA (Google Gemini). Chave do Google AI Studio: https://aistudio.google.com/apikey
# Sem a chave, as análises terminam com o status "failed" e a mensagem de que
# a IA não está configurada.
GEMINI_API_KEY=
# Confira os modelos disponíveis em https://ai.google.dev/gemini-api/docs/models
# Os modelos "pro" exigem plano pago; no nível gratuito use um "flash".
GEMINI_MODEL=gemini-3.8-flash
# Usado quando o principal responde 429/503 (cota ou congestionamento)
GEMINI_FALLBACK_MODEL=gemini-3.5-flash

# Origens do frontend autorizadas (separadas por vírgula)
CORS_ORIGINS=http://localhost:3000

# Limites (o limite de tamanho deve ser igual ao do bucket no Supabase)
MAX_UPLOAD_MB=50
MAX_IMAGE_MB=5
MAX_VIDEO_DURATION_SECONDS=600
MAX_CONCURRENT_ANALYSES=2

# ---- Pagamento (Stripe): plano Creator, pagamento único ----
# Developers → API keys → Secret key (sk_live_… em produção, sk_test_… para testar)
STRIPE_SECRET_KEY=
# Developers → Webhooks → o endpoint /api/stripe/webhook → Signing secret (whsec_…)
STRIPE_WEBHOOK_SECRET=
# Uploads grátis (no total) para quem ainda não tem o Lifetime; o Lifetime é ilimitado
FREE_UPLOADS=5
# Publishub Partners: indicações que compraram o Lifetime para ganhar o Lifetime de graça
PARTNERS_GOAL=5
# Comissão do Partner sobre o valor pago pelo indicado (0.30 = 30%)
PARTNERS_COMMISSION_RATE=0.30
# Status de quem acaba de entrar no programa: active (padrão), pending ou paused
PARTNERS_DEFAULT_STATUS=active

# ---- Primeiro uso sem cadastro (previsão cega) ----
# Sal do hash do IP usado no limite anti-abuso. Em branco, a service_role key
# serve de sal: o IP nunca é guardado em claro de qualquer jeito.
GUEST_HASH_SALT=
# Vídeos de convidado por IP por dia (o convidado tem direito a 1 por sessão)
GUEST_VIDEOS_PER_IP=1

# ---- Admin ----
# E-mails que enxergam /api/admin/* e a página /admin/partners (separados por vírgula)
ADMIN_EMAILS=

# ---- E-mail que fecha o loop (Resend) ----
# Chave do Resend (resend.com → API Keys). Sem ela os lembretes ficam na fila.
RESEND_API_KEY=
# Remetente verificado no Resend, ex.: "Publishub <ola@getpublishub.com>"
EMAIL_FROM=
EMAIL_REPLY_TO=
# Base dos links do e-mail: a URL do site (não a da API)
APP_URL=http://localhost:3000
# Protege POST /api/internal/followups, chamado pelo cron da Vercel
INTERNAL_SECRET=
# Sem data informada: quantas horas depois da análise o lembrete sai
FOLLOWUP_HOURS=72
# Com data informada: quantas horas depois dela
FOLLOWUP_AFTER_REPUBLISH_HOURS=48

# ---- Manus (opcional): mandar o plano de ação para um agente executar ----
# Cifra a chave do Manus de cada criador antes de guardar. Sem este segredo a
# integração fica desligada e a seção some da tela — o resto funciona igual.
# Gere um valor longo e aleatório e NÃO mude depois: mudar invalida as chaves
# guardadas e todo mundo precisa reconectar.
MANUS_KEY_SECRET=
# Base da API do Manus (v2). Só mude para testar contra outro ambiente.
MANUS_API_BASE=https://api.manus.ai
# Perfil do agente: standard, lite ou max
MANUS_AGENT_PROFILE=standard
