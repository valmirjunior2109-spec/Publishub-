# Publishub backend — copie para `.env` e preencha.
# Este arquivo é só o MODELO: deixe todos os valores em branco, porque ele vai
# para o Git. As chaves de verdade ficam no `.env`, que nunca é versionado.

# Supabase → Project Settings → API
SUPABASE_URL=
# Chave secreta (service_role / "secret key"). Só existe no backend.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=videos

# IA (Google Gemini). Chave do Google AI Studio: https://aistudio.google.com/apikey
# Sem a chave, as análises terminam com o status "failed" e a mensagem de que
# a IA não está configurada.
GEMINI_API_KEY=
# Confira os modelos disponíveis em https://ai.google.dev/gemini-api/docs/models
# Os modelos "pro" exigem plano pago; no nível gratuito use um "flash".
GEMINI_MODEL=gemini-3.8-flash

# Origens do frontend autorizadas (separadas por vírgula)
CORS_ORIGINS=http://localhost:3000

# Limites (o limite de tamanho deve ser igual ao do bucket no Supabase)
MAX_UPLOAD_MB=50
MAX_VIDEO_DURATION_SECONDS=600
MAX_CONCURRENT_ANALYSES=2
