# Publishub frontend — copie para `.env.local` e preencha.
# Variáveis NEXT_PUBLIC_ vão para o navegador: coloque aqui APENAS valores
# públicos. Nunca a service_role key nem chaves de IA.

# Supabase → Project Settings → API (URL e chave pública anon/publishable)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=videos

# URL do backend FastAPI
NEXT_PUBLIC_API_URL=http://localhost:8000

# Deve ser igual ao limite do bucket e ao MAX_UPLOAD_MB do backend
NEXT_PUBLIC_MAX_UPLOAD_MB=50
