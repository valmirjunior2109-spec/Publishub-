# Publishub frontend — copie para `.env.local` e preencha.
# Variáveis NEXT_PUBLIC_ vão para o navegador: coloque aqui APENAS valores
# públicos. Nunca a service_role key nem chaves de IA.

# Supabase → Project Settings → API (URL e chave pública anon/publishable)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=videos

# URL do backend FastAPI
NEXT_PUBLIC_API_URL=http://localhost:8000

# Deve ser igual ao limite do bucket e ao MAX_UPLOAD_MB do backend
NEXT_PUBLIC_MAX_UPLOAD_MB=50

# ---- Cron do lembrete de 72h (só no servidor, sem NEXT_PUBLIC) ----
# A Vercel assina a chamada do cron com este segredo
CRON_SECRET=
# O mesmo INTERNAL_SECRET do backend
INTERNAL_SECRET=
# URL do backend vista pelo servidor do Next (padrão: NEXT_PUBLIC_API_URL)
API_URL=http://localhost:8000

# ---- Suporte (e-mail que uma pessoa le) ----
NEXT_PUBLIC_SUPPORT_EMAIL=copilot@getpublishub.com

# ---- SEO ----
# O endereço que a Vercel serve como principal (hoje, com www): vai no canonical, no hreflang, no sitemap e no robots
NEXT_PUBLIC_SITE_URL=https://www.getpublishub.com
# Google Search Console → Adicionar propriedade → Tag HTML: só o valor de content="..."
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ---- PostHog (opcional) ----
# Project settings → Project API key (phc_…). Vazia = o SDK nem é carregado.
NEXT_PUBLIC_POSTHOG_KEY=
# Região do projeto: https://us.i.posthog.com ou https://eu.i.posthog.com
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
