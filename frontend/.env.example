# Publishub (verificação de aplicações feitas com IA) — copie para `.env.local` e preencha.
# Variáveis NEXT_PUBLIC_ vão para o navegador: só valores públicos aqui.
# As outras ficam só no servidor (rotas da API e scripts).

# ---- Site ----
NEXT_PUBLIC_SITE_URL=https://getpublishub.com
NEXT_PUBLIC_SUPPORT_EMAIL=copilot@getpublishub.com
# Google Search Console → Tag HTML: só o valor de content="..."
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ---- Supabase ----
# Project Settings → API. A URL e a chave pública (login do /admin):
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# a service_role, só no servidor (lista de espera, Founding Customers, /admin). Nunca com NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# opcional: se vazia, usa NEXT_PUBLIC_SUPABASE_URL
SUPABASE_URL=
# opcional: sal do hash de IP da lista de espera (padrão: a service_role). O nome é histórico; não renomeie,
# trocar o sal só zera o rate limit, mas mantém o valor atual em produção.
SCAN_HASH_SECRET=

# ---- Teste grátis (/check) ----
# opcional: prazo do teste em ms (padrão 45000; a função da Vercel tem 60 s)
CHECK_DEADLINE_MS=
# opcional: teto de testes por hora no site inteiro (padrão 300), para o custo não disparar
CHECK_GLOBAL_PER_HOUR=
# só em desenvolvimento ou no script de lote: o caminho de um Chrome/Edge instalado
# (na Vercel fica vazio: o teste usa o @sparticuz/chromium)
CHROME_EXECUTABLE_PATH=

# ---- Admin ----
# o e-mail (ou e-mails, separados por vírgula) que pode abrir o /admin
ADMIN_EMAIL=

# ---- Stripe (Founding Customers) ----
STRIPE_SECRET_KEY=
# o segredo do endpoint https://getpublishub.com/api/stripe/webhook
STRIPE_FOUNDING_WEBHOOK_SECRET=
# opcional. Vazia = price_1UaLsA2cdYlX3v8aM3XWVcLT (o preço recorrente de produção, no código).
# Use para apontar para um preço do modo de teste.
STRIPE_FOUNDING_CUSTOMERS_PRICE_ID=
# Só em teste local, com o stripe-mock (ex.: http://localhost:12111). Em produção, NÃO defina.
STRIPE_API_BASE=

# ---- PostHog (opcional) ----
NEXT_PUBLIC_POSTHOG_KEY=phc_nrYdgDwGwRfmjufEEQiqDahEuZsg3cUTC3RrmmuJDbV4
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# ---- Feedback da proposta (seção "Tell us what you think" da home) ----
# Cada resposta fica na tabela proposal_feedback e é encaminhada por e-mail via Resend (resend.com).
# Sem RESEND_API_KEY, o feedback só fica no banco.
RESEND_API_KEY=
# o remetente: precisa ser de um domínio verificado no Resend (ex.: getpublishub.com)
FEEDBACK_FROM_EMAIL=Publishub Feedback <feedback@getpublishub.com>
# opcional: para onde vai o feedback (padrão: copilot@getpublishub.com)
FEEDBACK_TO_EMAIL=
