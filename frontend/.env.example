# Publishub (scanner de acessibilidade) — copie para `.env.local` e preencha.
# Variáveis NEXT_PUBLIC_ vão para o navegador: só valores públicos aqui.
# As outras ficam só no servidor (rotas da API e o worker).

# ---- Site ----
NEXT_PUBLIC_SITE_URL=https://www.getpublishub.com
NEXT_PUBLIC_SUPPORT_EMAIL=copilot@getpublishub.com
# Google Search Console → Tag HTML: só o valor de content="..."
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ---- Supabase ----
# Project Settings → API. A URL e a chave pública (login do /admin):
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NOVA: a service_role, só no servidor (scans, relatórios, leads e reservas). Nunca com NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# opcional: se vazia, usa NEXT_PUBLIC_SUPABASE_URL
SUPABASE_URL=

# ---- Admin ----
# NOVA: o e-mail (ou e-mails, separados por vírgula) que pode abrir o /admin
ADMIN_EMAIL=

# ---- Scanner ----
# NOVA: "vercel" (padrão: a própria rota roda o scan em até ~50 s) ou "worker" (só enfileira; o worker processa)
SCANNER_MODE=vercel
# opcional: prazo total do scan em ms (padrão 48000 na Vercel, 150000 no worker)
SCAN_DEADLINE_MS=
# opcional: sal do hash de IP e do token do relatório (padrão: a service_role)
SCAN_HASH_SECRET=
# só em desenvolvimento ou num worker com Chrome próprio: o caminho do Chrome/Edge
CHROME_EXECUTABLE_PATH=
# já existia: autoriza chamadas internas a /api/scan/[id]/run
INTERNAL_SECRET=

# ---- Stripe (Founding plan) ----
# NOVA no frontend: a chave secreta (antes só o backend Python tinha)
STRIPE_SECRET_KEY=
# NOVA: o preço de US$ 49 (pagamento único). Vazia = o Checkout cria o preço na hora.
STRIPE_FOUNDING_PRICE_ID=
# NOVA: o segredo do endpoint https://www.getpublishub.com/api/stripe/webhook
STRIPE_FOUNDING_WEBHOOK_SECRET=
# Founding Customers (assinatura): opcional. Vazia = price_1UaLsA2cdYlX3v8aM3XWVcLT (o preço recorrente
# de produção, no código). Use para apontar para um preço do modo de teste.
STRIPE_FOUNDING_CUSTOMERS_PRICE_ID=
# Só em teste local, com o stripe-mock (ex.: http://localhost:12111). Em produção, NÃO defina.
STRIPE_API_BASE=

# ---- PostHog (opcional) ----
NEXT_PUBLIC_POSTHOG_KEY=phc_nrYdgDwGwRfmjufEEQiqDahEuZsg3cUTC3RrmmuJDbV4
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
