// Publishub MVP — database schema.
//
// Uses SQLite locally so the product runs with zero external setup.
// Swapping to Postgres/MySQL/Supabase later only requires changing the
// `datasource` block below (provider + url) and re-running `prisma migrate` —
// the models themselves are portable.
//
// There is intentionally no User/Auth model yet. `Video.ownerId` is a free
// text placeholder for whatever auth system gets wired in later.

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum AnalysisStatus {
  QUEUED
  PROCESSING
  ANALYZING
  DONE
  FAILED
}

model Video {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  // Placeholder for a future auth system. Null means "no account system yet".
  ownerId String?

  fileName String
  filePath String // path relative to the storage root
  mimeType String
  fileSize Int

  captionFileName String?
  captionFilePath String?

  // Probed technical metadata (filled in during processing).
  durationSec Float?
  width       Int?
  height      Int?
  fps         Float?

  // Optional performance context, supplied by the user, never required.
  // Kept as loose scalar fields for now; a dedicated Metrics model can
  // replace this later if the set of tracked signals grows.
  platform    String?
  views       Int?
  avgWatchPct Float?

  analysis Analysis?
}

model Analysis {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  videoId String @unique
  video   Video  @relation(fields: [videoId], references: [id], onDelete: Cascade)

  status AnalysisStatus @default(QUEUED)
  stage  String? // human-readable label for the current pipeline step
  error  String?

  // Raw objective metrics computed by ffmpeg (JSON, see src/lib/ai/types.ts)
  metricsJson String?

  // Structured AI output (JSON, see src/lib/ai/types.ts)
  resultJson String?
  aiProvider String?

  overallScore Int?

  startedAt   DateTime?
  completedAt DateTime?
}
